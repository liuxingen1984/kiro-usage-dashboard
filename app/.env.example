# Dashboard settings. `./deploy.sh env` writes app/.env from the Terraform outputs.
# Copy this file to app/.env only if you set the values by hand. Never commit app/.env.

# Region of the Kiro profile, the report bucket and the Athena/Glue resources
AWS_REGION=us-east-1
ATHENA_DATABASE=kiro_user_report
ATHENA_WORKGROUP=kiro-user-report-dashboard-workgroup
ATHENA_OUTPUT_BUCKET=s3://kiro-user-report-dashboard-athena-results-111122223333/

# Optional. Leave empty to use the only table in the Glue database.
GLUE_TABLE_NAME=

# IAM Identity Center identity store, used for user names and for hiding removed users.
# Leave IDENTITY_STORE_ID empty if your Kiro users are not in IAM Identity Center.
IDENTITY_STORE_ID=d-1234567890
# Region of the IAM Identity Center instance. Empty means the same as AWS_REGION.
IDENTITY_STORE_REGION=
